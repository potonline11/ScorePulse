# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in Vercel Environment Variables or AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted (optional on Vercel; VERCEL_URL used automatically).
APP_URL="MY_APP_URL"

# Persistent Telegram Group Bot settings (configure in Vercel Environment Variables)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional 1xBet Partner defaults
ONEXBET_PROMO_CODE=""
ONEXBET_PARTNER_LINK=""
